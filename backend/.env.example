# Comma-separated allowlist. Never *. Public API may add https://doctrace-one.vercel.app
# (Excel on the web loads that pane origin, not office.com). Not a VITE_ name.
CORS_ORIGIN=https://127.0.0.1:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
