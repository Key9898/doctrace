# Public only. Empty = local-first (task pane does not call the API).
# Do not set on Vercel until a public API is actually live. Empty means local-first.
# Never put DATABASE_URL, R2, or Brevo secrets on a VITE_ variable.
VITE_API_URL=

# Empty = hidden (showcase and client drop). Non-empty shows Trial Balance,
# Workpapers, and Client PBC Portal on this machine only. Restart Vite after
# changing. Do not set on Vercel. Not localhost/DEV-badge gated.
VITE_SHOW_PREP_MODULES=
