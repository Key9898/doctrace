{
  "name": "doctrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build",
    "certs:install": "office-addin-dev-certs install",
    "certs:verify": "office-addin-dev-certs verify",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,html,xml,svg}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,html,xml,svg}\"",
    "generate:assets": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "predev": "npm run certs:install",
    "runtime-log:disable": "office-addin-dev-settings runtime-log --disable",
    "runtime-log:enable": "office-addin-dev-settings runtime-log --enable",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run validate:manifest && vite build",
    "validate:manifest": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/office-js": "^1.0.468",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "happy-dom": "^17.4.4",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-dev-settings": "^2.0.5",
    "office-addin-manifest": "^2.0.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.1.1"
  }
}
